    "%@ Here": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hierher"
          }
        }
      }
    },
    "%@ in %@. Replacing overwrites them on the server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@. Ersetzen überschreibt sie auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$@. Replacing overwrites them on the server."
          }
        }
      }
    },
    "%@ is damaged. Edith won’t change it, so servers and settings you change now will not be saved.\n\nRepair the file, or replace it with a backup from %@, then restart Edith.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is damaged. Edith won’t change it, so servers and settings you change now will not be saved.\n\nRepair the file, or replace it with a backup from %2$@, then restart Edith."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist beschädigt. Edith ändert sie nicht, daher werden Server und Einstellungen, die du jetzt änderst, nicht gespeichert.\n\nRepariere die Datei oder ersetze sie durch ein Backup aus %@ und starte Edith neu."
          }
        }
      }
    },
